# ---- Provedor de WhatsApp: TESTE (padrão) | LOCAL | WAHA | META ----
# TESTE -> mensagens só aparecem no console, não precisa configurar nada abaixo.
# LOCAL -> conexão integrada do aplicativo, com QR Code e sem Docker.
# WAHA  -> servidor WAHA externo, para quem já possui essa integração.
# META  -> WhatsApp Business Cloud API oficial (precisa de app na Meta).
WHATSAPP_PROVIDER=TESTE

# ---- WAHA (WhatsApp HTTP API) ----
# Configure o endereço e a chave do servidor WAHA externo.
WAHA_URL=http://localhost:3000
WAHA_SESSION=default
# Gere com: python gerar_segredos.py
WAHA_API_KEY=

# ---- WhatsApp Business Cloud API (Meta) ----
WHATSAPP_TOKEN=
# App Secret do aplicativo Meta: necessário para validar a assinatura dos webhooks.
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Palavra secreta escolhida por você, usada na verificação do webhook na Meta
WHATSAPP_VERIFY_TOKEN=trocar_por_uma_palavra_secreta

# ---- URL pública onde o app está rodando (usada para montar o link único /m/<token>) ----
# Em desenvolvimento local com ngrok: https://xxxx.ngrok-free.app
# No aplicativo, o túnel integrado usa o endereço atual sem sobrescrever esta linha.
BASE_URL=http://localhost:5000

# ---- Restaurante ----
# Configure os dados da loja no painel ou, no modo servidor, neste arquivo.
NOME_RESTAURANTE=Barbaros Lanches
TELEFONE_RESTAURANTE=(47) 3000-0000
ENDERECO_RESTAURANTE=Rua das Hamburguerias, 123 - Centro
HORARIO_FUNCIONAMENTO=Terça a Domingo, das 18h às 23h30
TAXA_ENTREGA=6.00
CEP_RESTAURANTE=89460-000
RAIO_ENTREGA_KM=6

# ---- Banco de dados ----
# Caminho do arquivo SQLite (criado automaticamente)
DATABASE_PATH=data/deliverybot.db

# ---- Tempo estimado de preparo (minutos), usado na mensagem de confirmação ----
TEMPO_PREPARO_MIN=40

# ---- Validade do link único de pedido, em minutos ----
VALIDADE_LINK_MIN=30

# ---- IA (atendimento "humano", sem menu numerado) ----
# IA_PROVIDER: ANTHROPIC (API paga, melhor qualidade) | OLLAMA (modelo local
# gratuito, via https://ollama.com) | vazio (IA desativada, usa o menu fixo
# de sempre -- custo zero, comportamento padrão).
IA_PROVIDER=

# Usado só se IA_PROVIDER=ANTHROPIC. Pegue sua chave em
# https://console.anthropic.com (API paga por token, separada do Claude.ai).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Usado só se IA_PROVIDER=OLLAMA. Precisa do Ollama instalado e rodando
# localmente (ollama serve) com o modelo já baixado (ex: ollama pull llama3.2:3b).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Ajustes finos (opcional, estes valores padrão já funcionam bem):
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_PREDICT=160
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SEGUNDOS=120
# Pré-carrega o modelo na memória quando o Flask sobe, evitando que o
# primeiro cliente de verdade pague o tempo de carregamento (30-60s).
OLLAMA_AQUECER_AO_INICIAR=true

# Ignora tarefas comuns que ficarem mais de 5 minutos aguardando na fila.
BOT_FILA_MAX_IDADE_SEGUNDOS=300

# ============================================================================
# SEGURANÇA -- leia PRIVACIDADE E SEGURANÇA.md antes de expor o sistema
# pela internet (ngrok, domínio próprio, etc.)
#
# Gere valores fortes para TUDO abaixo rodando:  python gerar_segredos.py
# NUNCA reuse os exemplos deste arquivo, nunca cole esses valores em prints,
# chats, ou repositórios públicos.
# ============================================================================

# FLASK_DEBUG=true ativa o debugger interativo do Flask -- NUNCA deixe true
# com o sistema acessível pela internet (ngrok): permite executar código
# arbitrário no seu PC para quem achar uma página de erro.
FLASK_DEBUG=false

# Segredo embutido na URL dos webhooks (/webhook/waha/<segredo> e
# /api/bot/mensagem/<segredo>). Sem ele preenchido, esses endpoints ficam
# bloqueados por padrão (mais seguro esquecer de configurar do que deixar
# aberto sem querer).
WEBHOOK_SECRET=

# Login HTTP Basic do painel da cozinha (/cozinha).
# COZINHA_AUTH_MODO=SENHA (padrão): usa COZINHA_USUARIO + o HASH da senha
# (nunca a senha em texto puro). Defina a senha com:
#   python definir_senha_cozinha.py
# COZINHA_AUTH_MODO=WINDOWS: loga com o usuário/senha da própria conta do
# Windows desta máquina (requer "pip install pywin32"; não precisa definir
# COZINHA_SENHA_HASH neste modo).
COZINHA_AUTH_MODO=SENHA
COZINHA_USUARIO=admin
COZINHA_SENHA_HASH=

# Credenciais do dashboard/Swagger do WAHA externo, se utilizado.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# Limite de taxa: mensagens do mesmo telefone mais rápidas que isso (segundos)
# não chamam a IA de novo (usam o menu fixo) -- protege contra gasto de
# crédito por flood/abuso.
RATE_LIMIT_SEGUNDOS=2

# Tamanho máximo aceito no corpo de uma requisição HTTP, em bytes.
MAX_CONTENT_LENGTH=1048576

# ---- Privacidade e acesso administrativo ----
LGPD_RESPONSAVEL=
LGPD_CONTATO=
LGPD_MENSAGENS_DIAS=30
# NAO por padrão: bloqueia Anthropic/Ollama remoto no atendimento.
# Ollama em localhost continua funcionando. Revise fornecedores antes de habilitar.
LGPD_IA_EXTERNA=NAO
# No servidor: remoto exige HTTPS reconhecido pelo WSGI e autenticação.
ADMIN_PERMITIR_REMOTO=false

# Túnel integrado do aplicativo Windows (opt-in; não inicia no modo servidor).
TUNEL_MODO=RAPIDO
TUNEL_AUTOMATICO=NAO
TUNEL_URL=
TUNEL_TOKEN=
TUNEL_PORTA=5051
